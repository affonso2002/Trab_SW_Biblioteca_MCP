# A pasta de trabalho. Caminho relativo a pasta em que o servidor e iniciado ou caminho absoluto.
APP_DATA_DIR=./data

# Integracao opcional com Solr. Com false, as Tools continuam usando o indice Lucene local.
SOLR_ENABLED=false
SOLR_URL=http://localhost:8983/solr/gutenberg
GUTENBERG_URL=https://gutendex.com/books/

# Banco PostgreSQL para persistencia/metadados. Ajuste usuario, senha e URL ao seu ambiente.
POSTGRES_URL=jdbc:postgresql://localhost:5432/library
POSTGRES_USER=library
POSTGRES_PASSWORD=troque-por-uma-senha-local

# Banco MySQL para consulta de metadados (porta publicada 3307 no compose.yaml).
# Se o MySQL estiver instalado diretamente no host, ajuste para a porta local, normalmente 3306.
MYSQL_URL=jdbc:mysql://localhost:3307/library
MYSQL_USER=library
MYSQL_PASSWORD=troque-por-uma-senha-local
MYSQL_ROOT_PASSWORD=troque-por-uma-senha-root-local
